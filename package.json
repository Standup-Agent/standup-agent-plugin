{
  "name": "standup-agent-plugin",
  "private": true,
  "version": "0.0.9",
  "description": "Standup Agent — Claude Code plugin",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=cjs --outfile=plugin/dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "claude plugin validate plugin && claude plugin validate manager"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
